# =============================================================================
#  haalan 部署环境变量（模板）
#  ---------------------------------------------------------------------------
#  用法：复制成 .env 后按需修改
#      cp .env.example .env          # Linux / Git Bash
#      Copy-Item .env.example .env   # PowerShell
#
#  注意：.env 已被仓库 .gitignore 忽略（里面是口令），所以只提交这个模板。
# =============================================================================

# ---------------------------------------------------------------------------
#  Compose 项目名 —— 决定网络与数据卷的实际名字，改这里等于换一套数据
# ---------------------------------------------------------------------------
#  · 现有虚拟机（192.168.100.133）：填 root
#      网络 = root_haalan，卷 = root_redis-data / root_es-data / root_es-plugins
#           / root_mq-data / root_mq-plugins / root_nacos-data
#      这些正是当前 15 个容器在用的资源，所以数据零丢失。
#
#  · 换一台全新机器：删掉这一行（compose 会用目录名当项目名），或改成新名字。
#      注意：一旦改动，新项目会新建一套空卷，老数据不会自动跟过来。
COMPOSE_PROJECT_NAME=root

# ---------------------------------------------------------------------------
#  宿主机 IP —— Seata 要把它注册进 Nacos，供各业务服务回调
# ---------------------------------------------------------------------------
HOST_IP=192.168.100.133

# ---------------------------------------------------------------------------
#  中间件口令（与现有环境保持一致，改了要同步改 Nacos 里的配置）
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=123456
MQ_USER=haalan
MQ_PASSWORD=haalan

# ---------------------------------------------------------------------------
#  后端 JVM 参数
# ---------------------------------------------------------------------------
#  服务器 7.8 GB 内存 / 已跑 16 个容器 / 实测可用约 1 GB，
#  6 个 Spring Boot 必须封顶，否则并发重启会触发 OOM Killer。
#  留空则使用 JVM 默认值（换到大内存机器时可以留空）。
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m

# ---------------------------------------------------------------------------
#  Sentinel 控制台（容器 sentinel-dashboard，端口 8090）
# ---------------------------------------------------------------------------
#  部署方式见 scripts/deploy-sentinel.sh —— 它用 `docker run` 起本地镜像，
#  刻意不走 `docker compose --profile tools`，因为 compose 会先尝试 pull，
#  而服务器连不上 registry-1.docker.io。
SENTINEL_IMAGE=haalan/sentinel-dashboard:1.8.6
SENTINEL_CONTAINER=sentinel-dashboard
SENTINEL_PORT=8090
